{
  "name": "nirf-server",
  "version": "1.0.0",
  "description": "NIRF ranking calculator backend (Express + TS + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrations/run.ts",
    "seed-official": "tsx src/scripts/seedOfficial.ts",
    "seed-raw-dataset": "tsx src/scripts/buildRawDataset.ts",
    "scan-dataset": "tsx src/scripts/scanDataset.ts",
    "train-absolute": "tsx src/scripts/trainAbsolute.ts",
    "train:relative": "tsx src/scripts/trainRelative.ts",
    "seed-institutions": "tsx src/scripts/seedInstitutions.ts",
    "verify-engine": "tsx src/scripts/verifyEngine.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
